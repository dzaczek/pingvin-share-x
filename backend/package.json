    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "body-parser": "^2.2.0",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "check-disk-space": "^3.4.0",
    "clamscan": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "content-disposition": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "jmespath": "^0.16.0",
