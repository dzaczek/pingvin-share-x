    "rxjs": "^7.8.2",
    "serialize-javascript": "^7.1.0",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.2.1",
    "@types/archiver": "^8.0.0",
